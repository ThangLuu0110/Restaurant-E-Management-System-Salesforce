<?xml version="1.0" encoding="UTF-8" ?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Guest_User_Table_Sharing_Rules</fullName>
        <accessLevel>Read</accessLevel>
        <description
    >Cho phép guest đọc tất cả bàn để tra Id theo số bàn trên URL. Seating_Capacity__c là field bắt buộc nên điều kiện này bao toàn bộ bản ghi.</description>
        <label>Guest User Table Sharing Rules</label>
        <sharedTo>
            <guestUser>LoveLycaRestaurantMenu</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>Seating_Capacity__c</field>
            <operation>greaterOrEqual</operation>
            <value>0</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
